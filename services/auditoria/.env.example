NODE_ENV=development
# Cadena de conexion de MongoDB. NO versionar credenciales reales: usar un .env local.
MONGO_URI=mongodb+srv://edisonenc80_db_user:ZUp7WDWVpTMlTwdq@cluster0.ce0hfi3.mongodb.net/
DB_NAME=auditoria_db
# Tiempo maximo (ms) de seleccion de servidor / consulta antes de responder 503 (> 0)
MONGO_TIMEOUT_MS=2000
# Paginacion del listado: tamano por defecto y maximo aceptado (enteros > 0; defecto <= maximo)
PAGINA_TAMANO_DEFECTO=20
PAGINA_TAMANO_MAXIMO=100
# Reintentos y espera (ms) para crear los indices si MongoDB no esta listo al arrancar
DB_INIT_REINTENTOS=10
DB_INIT_ESPERA_MS=2000