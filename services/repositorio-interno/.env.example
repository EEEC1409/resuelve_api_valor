PORT=8092
NODE_ENV=development
DB_HOST=ep-twilight-bread-b4bz9kli-pooler.c-6.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=npg_4TI5zYHMDnSg
DB_NAME=resuelve_db
# TLS hacia la base: "true" para Neon u otra base en la nube (por defecto false)
DB_SSL=false
# Conexiones maximas del pool (entero > 0)
DB_POOL_MAX=10
# Tiempo maximo (ms) para obtener una conexion antes de responder 503 (> 0)
DB_CONEXION_TIMEOUT_MS=1500
# Tiempo maximo (ms) de una consulta antes de cancelarla y responder 503 (> 0)
# DB_CONEXION_TIMEOUT_MS + DB_CONSULTA_TIMEOUT_MS debe ser < 4000 (timeout del adaptador del core)
DB_CONSULTA_TIMEOUT_MS=2000
# Crear el esquema y cargar los datos semilla al arrancar (solo "false" lo desactiva)
SEED_AL_INICIAR=true
# Reintentos y espera (ms) entre intentos de siembra si la base no esta lista al arrancar
DB_INIT_REINTENTOS=10
DB_INIT_ESPERA_MS=2000
